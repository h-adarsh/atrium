# =====================================================================
# Atrium Production Configuration for OCI Always Free Deployment
# Copy this file to .env before starting docker-compose:
#   cp .env.production.example .env
# =====================================================================

# 1. Environment
NODE_ENV=production
PORT=5001

# 2. Database (PostgreSQL)
POSTGRES_USER=atrium_admin
# Generate strong password with: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_strong_database_password_here
POSTGRES_DB=atrium

# 3. Security (JWT Authentication)
# CRITICAL: Must be at least 32 characters.
# Generate strong secret with: openssl rand -base64 32
JWT_SECRET=replace_with_cryptographically_strong_random_secret_at_least_32_characters

# 4. Domain & Client Origin
# Set to your OCI Public IP or your registered domain name (e.g. https://portal.yourdomain.com)
CLIENT_URL=https://portal.yourdomain.com,http://localhost:5001

# 5. Optional Flags
ENABLE_DEMO_ACCOUNTS=false
SEED_ON_STARTUP=true

